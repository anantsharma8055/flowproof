# Copy to .env and fill in. Never commit .env. Keep each variable on its own line.

# --- LLM for the agent (any OpenAI-compatible API) ---
# Gemini free tier (recommended): key from Google AI Studio
FLOWPROOF_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FLOWPROOF_API_KEY=your_gemini_key
# List the models your key can use with: uv run python cli/models.py
FLOWPROOF_MODEL=gemini-3.6-flash
# Comma-separated models tried in order when the main one is overloaded
FLOWPROOF_FALLBACKS=gemini-3.5-flash-lite,gemini-3.5-flash

# Groq alternative: comment out the Gemini block above and use these
# GROQ_API_KEY=your_groq_key
# FLOWPROOF_MODEL=openai/gpt-oss-120b

# --- Synapse (needed only for hosted servers: servers.hosted.json) ---
SYNAPSE_API_KEY=your_synapse_key
